#. Translators: Label for a setting in synth settings ring.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:258
msgid "Remove punctuation at pause points"
msgstr "إزالة علامات الترقيم عند مواضع التوقف"

#. Translators: Label for a pipeline setting in the voice settings panel and
#. the Speech Pipeline panel;
#. also the label of the setting's pipeline log switch in the Log Record
