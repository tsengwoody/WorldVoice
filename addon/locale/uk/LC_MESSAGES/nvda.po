#. Translators: Label for a pipeline setting in the voice settings panel and
#. the Speech Pipeline panel.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:190
msgid "Group size"
msgstr "Розмір групи"

#. Translators: Label for a pipeline setting in the voice settings panel and
#. the Speech Pipeline panel;
#. also the label of the setting's pipeline log switch in the Log Record
#. panel.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:207
msgid "Number wait factor"
msgstr "Пауза між цифрами"

#. Translators: Label for a pipeline setting in the voice settings panel and
#. the Speech Pipeline panel;
#. also the label of the setting's pipeline log switch in the Log Record
#. panel.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:217
