#. Translators: The title of the Export pipeline log file window
#: addon/globalPlugins/WorldVoice/pipelineLog.py:47
msgid "Export pipeline log files..."
msgstr "İşlem Hattı Günlük Dosyalarını Dışa Aktar ..."

#: addon/globalPlugins/WorldVoice/pipelineLog.py:60
msgid ""
"Log exported to:\n"
"{}"
msgstr ""
"Günlük şurada dışa aktarıldı:\n"
"{}"

#: addon/globalPlugins/WorldVoice/pipelineLog.py:61
msgid "Success"
msgstr "Başarılı"

#: addon/globalPlugins/WorldVoice/pipelineLog.py:66
