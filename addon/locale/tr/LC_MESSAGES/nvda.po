#. WorldVoice only.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:50
msgid "Only WorldVoice Synthesizer"
msgstr "Sadece WorldVoice sentezleyici"

#. Translators: A number mode: numbers are left as they are.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:56
msgid "off"
msgstr "kapalı"

#. Translators: A number mode: a number is read as a value, for example "one
#. hundred twenty-three".
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:58
msgid "value"
msgstr "değer"

#. Translators: A number mode: the digits of a number are read one by one.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:60
msgid "number"
msgstr "sayı"

#. Translators: A number mode: the digits of a number are read in groups of
#. the chosen size, counted from the left.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:62
msgid "group"
msgstr "grup"

#. Translators: A number language choice: numbers are read in the language of
#. the text around them.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:68
msgid "Follow text language"
msgstr "Metin dilini takip et"

#. Translators: A number language choice: numbers are read in the main
#. language, the language the
#. document marks or the main voice's language.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:71
msgid "Follow main language"
msgstr "Ana dili takip et"

