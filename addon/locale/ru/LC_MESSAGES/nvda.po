#: addon/synthDrivers/WorldVoice/__init__.py:470
msgid "default"
msgstr "по умолчанию"

#. Translators: A choice of the Speech Pipeline panel's effect scope: every synthesizer.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:37
msgid "All Synthesizers (Global)"
msgstr "Все синтезаторы (глобальный)"

#. Translators: A choice of the Speech Pipeline panel's effect scope: WorldVoice only.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:39
msgid "Only WorldVoice Synthesizer"
msgstr "Только синтезатор WorldVoice"

#. Translators: A number mode: numbers are left as they are.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:45
msgid "off"
msgstr "не обрабатывать"

#. Translators: A number mode: a number is read as a value, for example "one hundred twenty-three".
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:47
msgid "value"
msgstr "целым числом"

#. Translators: A number mode: the digits of a number are read one by one.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:49
msgid "number"
msgstr "по цифрам"

#. Translators: A number mode: the digits of a number are read in groups of the chosen size, counted from the left.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:51
msgid "group"
msgstr "группами"

#. Translators: A number language choice: numbers are read in the language of the text around them.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:57
msgid "Follow surrounding text language"
msgstr "Следовать языку окружающего текста"

#. Translators: A number language choice: numbers are read in the main language, the language the
#. document marks or the main voice's language.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:60
msgid "Follow main language"
msgstr "Следовать основному языку"

#. Translators: Label for a pipeline setting in the Speech Pipeline panel.
#: addon/synthDrivers/WorldVoice/pipeline/settings.py:149
msgid "Effect scope"
msgstr "Область применения"

